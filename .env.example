# Persona — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real values to source control.

# ============================================================
# DEVELOPMENT ONLY
# ============================================================

# Enable the Mock Agent test harness (local dev only).
# Set to "true" to show the MockAgent console panel in the browser.
# In production this must be unset or "false".
VITE_ENABLE_MOCK_AGENT=false

# ============================================================
# NO BACKEND / NO API KEYS REQUIRED
# ============================================================
# Persona is a fully client-side application.
# All AI reasoning is performed by the external WebMCP agent (ChatGPT).
# No OpenAI API key, no server-side secret, no auth token is needed.
